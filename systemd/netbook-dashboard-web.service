[Unit]
Description=Netbook Dashboard Webview (nur Ansicht)
After=network-online.target netbook-checker.service
Wants=network-online.target

[Service]
Type=simple
User=bp
WorkingDirectory=/opt/netbook-dashboard
ExecStart=/usr/bin/python3 /opt/netbook-dashboard/web.py
Restart=always
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
